# Development flavour: the lean image plus compilers, debuggers, headers and ffmpeg.
FROM        --platform=$TARGETOS/$TARGETARCH debian:trixie-slim

LABEL       author="Skyport" maintainer="container@skyport"

LABEL       org.opencontainers.image.authors="container@skyport"
LABEL       org.opencontainers.image.source="https://github.com/skyportsh/depot"
LABEL       org.opencontainers.image.licenses=MIT

ENV         DEBIAN_FRONTEND=noninteractive

RUN         apt-get update \
                && apt-get upgrade -y \
                && apt-get install -y --no-install-recommends \
                    gcc g++ libgcc-s1 libc++-dev gdb libc6 git wget curl tar zip unzip binutils xz-utils \
                    liblzo2-2 cabextract iproute2 net-tools netcat-traditional telnet libatomic1 \
                    libsdl1.2debian libsdl2-2.0-0 libfontconfig1 libicu76 icu-devtools libunwind8 \
                    libssl-dev sqlite3 libsqlite3-dev libmariadb-dev libduktape207 locales ffmpeg gnupg2 \
                    apt-transport-https ca-certificates tzdata liblua5.3-0 \
                    zlib1g-dev rapidjson-dev \
                && sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
                && locale-gen \
                && apt-get clean \
                && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info \
                && useradd -m -d /home/container -s /bin/bash container

USER        container
ENV         USER=container HOME=/home/container LANG=en_US.UTF-8
WORKDIR     /home/container

COPY        ./entrypoint.sh /entrypoint.sh
CMD         [ "/bin/bash", "/entrypoint.sh" ]
